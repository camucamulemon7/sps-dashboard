# Dashboard
DASHBOARD_PORT=8090
DASHBOARD_TITLE=LLM Usage Dashboard
DASHBOARD_REFRESH_SECONDS=60
DASHBOARD_DEFAULT_RANGE=7d
DASHBOARD_ALLOWED_RANGES=24h,7d,30d
REQUEST_TIMEOUT_SECONDS=20

# SharePointからのiframe埋め込みを許可するオリジン。
# 実際のSPS/SPO URLへ変更してください。スペース区切りで複数指定できます。
FRAME_ANCESTORS='self' http://sps.example.local https://sps.example.local

# Langfuse v4 Metrics API
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://host.docker.internal:3000
LANGFUSE_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_SECRET_KEY=sk-lf-change-me

# ユーザー別集計で走査するObservation数の上限
LANGFUSE_MAX_OBSERVATIONS=10000
